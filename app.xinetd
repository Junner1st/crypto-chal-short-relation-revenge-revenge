service app
{
    disable         = no
    type            = UNLISTED
    socket_type     = stream
    protocol        = tcp
    wait            = no
    user            = ctf
    server          = /app/run
    port            = 5000
    bind            = 0.0.0.0
    flags           = NODELAY
    instances       = UNLIMITED
    per_source      = UNLIMITED
    cps             = 0 0
    passenv         = FLAG
}